# Volunteer Coordinator — Environment Variables
# Copy this file to .env and fill in your values.

# GitHub token for creating issues in the volunteer program repo
# Required for: monthly-report workflow (capacity alerts as GitHub issues)
# Scopes needed: repo (or public_repo for public repos)
# Get it at: https://github.com/settings/tokens
GITHUB_TOKEN=your_github_token_here

# Optional: Anthropic API key if running agents manually via claude CLI
# The ao daemon uses the system-configured API key by default
ANTHROPIC_API_KEY=your_anthropic_api_key_here
